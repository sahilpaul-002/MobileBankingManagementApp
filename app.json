{
  "expo": {
    "name": "Card Management App",
    "slug": "card-management-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/otherLogos/icon.png",
    "scheme": "cardmanagementapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/otherLogos/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c1830",
        "foregroundImage": "./src/assets/nativeSplashScreenLogo/walletCardLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Card Management App",
      "shortName": "Card Management",
      "output": "static",
      "favicon": "./src/assets/otherLogos/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c1830",
          "image": "./src/assets/nativeSplashScreenLogo/walletCardLogo.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
